#! /bin/csh -f

#PBS -N aero_gas_bwd
#PBS -l walltime=1:00:00
# BS -l nodes=4:ppn=6
# BS -l nodes=8:ppn=8
# BS -l nodes=2:ppn=4
#PBS -lselect=6:ncpus=6:model=wes
#PBS -W group_list=s1143
# BS -q batch
#PBS -q devel
#PBS -V
#PBS -j oe

# ======================= CCTMv4.7.1 Run Script ===================== #
# Usage: run.cctm >&! run.cctm.log &                                  #
# The following environment variables must be set for this script to  #
# execute properly:                                                   #
#   setenv M3DATA =  input/output data directory                      #
# To report problems or request help with this script/program:        #
#             http://www.cmascenter.org/help_desk.cfm                 #
# =================================================================== #

# source ./setcase_12km_test
set APPL   = gas
set M3DATA = /nobackup/mdturne1

#> Check that M3DATA is set:
 if ( ! -e $M3DATA ) then
    echo "   $M3DATA path does not exist"
    exit 1
    endif
 echo " "; echo " Input data path, M3DATA set to $M3DATA"; echo " "

#> Set the working directory:
 set BASE     = /home1/slcapps/cmaq_adj

#> Application name (no default)
 if ( ! $?APPL ) then
    echo 'Must set environment variable APPL (application name)'
    exit 1
 endif

#> Run mode: "ser" or "par" (default is par)
 if ( ! $?RM ) then
    echo 'RM (run mode) was not set; this will be a parallel run'
    set RM = par
 else if ( $RM != 'ser' && $RM != 'par' ) then
    echo 'RM (run mode) was set incorrectly; value must be either ser or par'
    exit 1
 endif

 set YR = 7
 set YER = 07
 set YEAR = 2007
 set MONTH = 05             # does not cross months yet
 set FIRSTDAY  = 20070501   # first day YYYYMMDD
 set DAY1 = 1 #9              # first day
 set EDAY = 1 #19 #25              # end day
 set IDAY = 1              # day for initial conditions

 set APPL_CASE = ${APPL}_bwd
 set CFG  = $BASE/BLD_${APPL_CASE}/cfg.bwd
 set EXEC = $BASE/BLD_${APPL_CASE}/ADJOINT_BWD

 cd $BASE; date; cat ${CFG}; echo "    "; set echo

#> horizontal domain decomposition
# set RM = ser
 if ( $RM == 'ser' ) then
    setenv NPCOL_NPROW "1 1"; set NPROCS   = 1 # single processor setting
 else
#    setenv NPCOL_NPROW "20 12"; set NPROCS   = 240
#    setenv NPCOL_NPROW "4 6"; set NPROCS   = 24
    setenv NPCOL_NPROW "6 6"; set NPROCS   = 36
 endif

#> for Scyld Beowulf ...
#setenv NP $NPROCS
#setenv BEOWULF_JOB_MAP -1:-1:0:0:1:1:2:2:3:3:4:4
#echo " task-processor map `beomap`"

#> Switch to the qsub directory; default launch location
 if ( $?PBS_JOBID ) then
    echo Job ID is $PBS_JOBID
    echo Queue is $PBS_O_QUEUE
    echo Working directory is $PBS_O_WORKDIR
    cd $PBS_O_WORKDIR
 endif
 echo '>>>>>> start model run at ' `date`
 set echo # Display each line after variables have been substituted

# Directories
 #set PTMP    = $PBS_O_WORKDIR
 set PTMP    = /nobackupp8/slcapps/cmaqadj/output
 #set PTMP    = /work/MOD3EVAL/has/omi/co_20110224/run
 set PTMPOUT = $PTMP
 set BASE    = $PTMP
 set BASE2   = /nobackupp8/slcapps/cmaqadj/output
# Formerly BASE2 = $PTMP/../code/debug # BLD_N4a also
# set EXEC    = ADJOINT_FWD
 set OUTDIR  = /nobackupp8/slcapps/cmaqadj/output  #$PTMPOUT
 #if ( ! -d "$OUTDIR" ) mkdir -p $OUTDIR
 set OUTDIR2  = $OUTDIR

# Set up
limit stacksize 100000
limit stacksize unlimited

#> set log file [ default = unit 6 ]; uncomment to write standard output to a log
#setenv LOGFILE $BASE/$APPL_CASE.log

#> turn off excess WRITE3 logging
 setenv IOAPI_LOG_WRITE F

#> max sync time step (sec) (default is 720)
#setenv CTM_MAXSYNC 720
 setenv CTM_MAXSYNC 400

#> min sync time step (sec) (default is 60)
#setenv CTM_MINSYNC 720
 setenv CTM_MINSYNC 400

#> sync time step (sec) (default is 600)
#setenv CTM_SYNC_STEP 600

#> top sigma level thru which sync step determined (default is 0.7)
#setenv SIGMA_SYNC_TOP 0.7

#> maximum allowable horizontal divergence for an advection step (default is 1.0)
#setenv ADV_HDIV_LIM 1.0

#> aerosol diagnostic file [ T | Y | F | N ] (default is F|N)
#setenv CTM_AERDIAG Y

#> sea-salt emissions diagnostic file [ T | Y | F | N ] (default is F|N)
#setenv CTM_SSEMDIAG Y

#> flag for in-line deposition velocities [ T | Y | F | N ] (default is T|Y)
#setenv CTM_ILDEPV F

#> use in-line plume rise emissions [ N|F ]
 setenv CTM_PT3DEMIS F

 if ( $?CTM_PT3DEMIS ) then   # $CTM_PT3DEMIS is defined
    if ( $CTM_PT3DEMIS == 'Y' || $CTM_PT3DEMIS == 'T' ) then
       set pt3don = 1
       setenv PT3DDIAG Y  # optional 3d point source emissions diagnostic file [N]
    else
       set pt3don = 0
    endif
 else   # $CTM_PT3DEMIS is not defined => $CTM_PT3DEMIS == 'N
    set pt3don = 0
 endif

#> Kz min on flag [ T | Y | F | N ]
 setenv KZMIN N

#> stop on inconsistent input file [ T | Y | F | N ]
 setenv FL_ERR_STOP F

#> turn off I/O-API PROMPT*FILE interactive mode
setenv PROMPTFLAG F

#> set ancillary log file name extensions
 setenv CTM_APPL $APPL_CASE

#> horizontal grid defn; check GRIDDESC file for GRID_NAME options
# setenv GRIDDESC /home/mturner/CMAQ/scripts/GRIDDESC3
# setenv GRID_NAME TX_CCTM_uh04
# setenv GRID_NAME C_36_OAQPS
 setenv GRIDDESC /nobackup/mdturne1/GRIDDESC12
 setenv GRID_NAME 12US2

#> species for standard conc
#setenv CONC_SPCS "O3 AECJ NO CO NO2 NH3 A25J ASO4J ANH4J ANO3J"

#> layer range for standard conc
#setenv CONC_BLEV_ELEV " 1 4"

#> species for integral average conc
#setenv AVG_CONC_SPCS "O3 AECJ NO CO NO2 NH3 A25J ASO4J ANH4J ANO3J"
#setenv AVG_CONC_SPCS "ALL"
#setenv AVG_CONC_SPCS "O3 NO CO NO2"
# setenv AVG_CONC_SPCS ""

#> layer range for integral average conc
# setenv ACONC_BLEV_ELEV " 1 1"

 set OCEANpath = $M3DATA/emis/2007
 set OCEANfile = 12US2_surf.ncf

# Julian day adjustment (non-leap year is commented out)
if ( $MONTH == 01 ) then
 set juladd = 0
else if ( $MONTH == 02 ) then
 set juladd = 31
else if ( $MONTH == 03 ) then
 set juladd = 59  #60
else if ( $MONTH == 04 ) then
 set juladd = 90  #91
else if ( $MONTH == 05 ) then
 set juladd = 120 #121
else if ( $MONTH == 06 ) then
 set juladd = 151 #152
else if ( $MONTH == 07 ) then
 set juladd = 181 #182
else if ( $MONTH == 08 ) then
 set juladd = 212 #213
else if ( $MONTH == 09 ) then
 set juladd = 243 #244
else if ( $MONTH == 10 ) then
 set juladd = 273 #274
else if ( $MONTH == 11 ) then
 set juladd = 304 #305
else if ( $MONTH == 12 ) then
 set juladd = 334 #335
else
 echo " MONTH MUST BE BETWEEN 1-12 "
 exit (1)
endif

set dd1 = `seq $DAY1 $EDAY`
set i = $DAY1
 while ( $i <= $EDAY )
   @ jd = $juladd + $i
   if ( $i == $DAY1 ) then
     set md1 = ( ${MONTH}0$i )
     if ( $jd < 10 ) then
       set jd1 = ( 00$jd )
     else
       if ( $jd < 100 ) then
         set jd1 = ( 0$jd )
       else
         set jd1 = ( $jd )
       endif
     endif
   else
     if ( $i < 10 ) then
        set md1 = ( $md1 ${MONTH}0$i )
     else
        set md1 = ( $md1 ${MONTH}$i )
     endif
     if ( $jd < 10 ) then
       set jd1 = ( $jd1 00$jd )
     else
       if ( $jd < 100 ) then
         set jd1 = ( $jd1 0$jd )
       else
         set jd1 = ( $jd1 $jd )
       endif
     endif
   endif
   @ i ++
 end

#> remove existing output files?
#set DISP = delete
 set DISP = update
#set DISP = keep


###> Testing the implementation of offline adjoint forcing functions.
#>      See ADJOINT_FILES.F and driver_bwd.f for details
#> A receptor function for sensitivity analysis is the average mixing ratio
#> of the receptor's species over the cells in the receptor's domain. The
#> sensitivity of the receptor's species to another species is the partial
#> derivative of the receptor function with respect to the mixing ratio of
#> the other species.

#> Receptor species
# setenv RECPTR_SPC AECJ

#> Column, row and level ranges for receptor
#>>> user must check GRIDDESC for validity!
# Define receptor location definition file
# setenv RECPTR_FILENAME "/nobackup/mdturne1/Continental_US_definition.txt"
# setenv RECPTR_BCOL_ECOL "130 130"
# setenv RECPTR_BCOL_ECOL "1 396"
# setenv RECPTR_BROW_EROW "68 68"
# setenv RECPTR_BROW_EROW "1 246"
# setenv RECPTR_BLEV_ELEV "1 1"

#> timestep run parameters for multi-day run
set begin = 1
set end = 1   # final date (first day of adjoint)

set i = ${end}
set j = ${begin}
while ( $i >= ${begin} )
   if ( $j == ${begin} ) then
      set number = ( $i )
   else
      set number = ( $number $i )
   endif
   @ i --
   @ j ++
end
foreach i ( $number )

 @ day  = $DAY1
# echo $day
 set STDAT  = `echo $day | awk '{printf("%2.2d",$1)}'`
# @ STDATE   = $day + $juladd + $YR * 1000 + 2000000
 set APPL   = $YEAR$MONTH$STDAT
# set EMISDATE   = $YEAR$MONTH$day
 echo $STDAT

 set STDATE   = ${YEAR}${jd1[$i]}       # beginning date
#> just for testing over 5 hours
# set STTIME   = 000000        # beginning GMT time (HHMMSS)
 set STTIME   = 000000        # beginning GMT time (HHMMSS)
 set TSTEP    = 010000        # output time step interval (HHMMSS)
# set NSTEPS   = 240000
 set NSTEPS   = 050000

# Define parameters that determine for how long the cost function is evaluated

#@ cf_start = $begin + 3
#@ cf_start = $begin
# setenv CF_BEGIN_DATE ${YEAR}${jd1[$cf_start]}
# setenv CF_BEGIN_TIME 000000

#@ next = $end + 1
# setenv CF_END_DATE ${YEAR}${jd1[$next]}
# setenv CF_END_TIME 000000

 set fwd_case = 238

#> output files and directories
# set OUTDIR   = $M3DATA/cctm/${YEAR}${jd1[1]}/${PBS_JOBID}
# set OUTDIR   = $M3DATA/cctm/${YEAR}${jd1[1]}/aero_vdiff_fd
# set OUTDIR   = $M3DATA/cctm/${YEAR}${jd1[1]}/aero_vdiff_clouds_fd
# set OUTDIR   = $M3DATA/cctm/${YEAR}${jd1[1]}/adj_fwd_12km_test
 set OUTDIR   =  /nobackup/slcapps/cmaqadj/output 
 if ( ! -d "$OUTDIR" ) mkdir -p $OUTDIR
 set CONCfile  = CONC.${APPL}.${fwd_case}   # CTM_CONC_1
# set ACONCfile = ACONC.${APPL}.${fwd_case}   # CTM_ACONC_1
 set CGRIDfile = CGRID.${APPL}.${fwd_case}   # CTM_CGRID_1
 set DD1file   = DRYDEP.${APPL}.${fwd_case}  # CTM_DRY_DEP_1
 set WD1file   = WETDEP1.${APPL}.${fwd_case} # CTM_WET_DEP_1
# set WD2file   = WETDEP2.${APPL}.${fwd_case} # CTM_WET_DEP_2
# set SS1file   = SSEMIS1.${APPL}.${fwd_case} # CTM_SSEMIS_1
 set AV1file   = AEROVIS.${APPL}.${fwd_case} # CTM_VIS_1
# set AD1file   = AERODIAM.${APPL}.${fwd_case} # CTM_DIAM_1
# set PA1file   = PA_1.${APPL}.${fwd_case}    # CTM_IPR_1
# set PA2file   = PA_2.${APPL}.${fwd_case}    # CTM_IPR_2
# set PA3file   = PA_3.${APPL}.${fwd_case}    # CTM_IPR_3
# set IRR1file  = IRR_1.${APPL}.${fwd_case}   # CTM_IRR_1
# set IRR2file  = IRR_2.${APPL}.${fwd_case}   # CTM_IRR_2
# set IRR3file  = IRR_3.${APPL}.${fwd_case}   # CTM_IRR_3
# set RJ1file   = RJ_1.${APPL}.${fwd_case}    # CTM_RJ_1
# set RJ2file   = RJ_2.${APPL}.${fwd_case}    # CTM_RJ_2

 setenv CHK_PATH "$OUTDIR"
 setenv ADJ_LGRID          "$OUTDIR/LGRID.${APPL_CASE}.${md1[$i]} -v"
# setenv ADJ_LGRID_EM_SF    "$OUTDIR/EM_SF.LGRID.${APPL_CASE}.${md1[$i]} -v"
# setenv ADJ_LGRID_EM       "$OUTDIR/EM.LGRID.${APPL_CASE}.${md1[$i]} -v"
# setenv ADJ_LGRID_EM_NRM  "$OUTDIR/EM_NORM.LGRID.${APPL_CASE}.${md1[$i]} -v"
# setenv CTM_MORT          "/nobackup/mdturne1/Mort_2010_12km.ncf -v"
# setenv CTM_AVG           "/nobackup/mdturne1/Yearly_avg_2007 -v"

 setenv CTM_XFIRST_OUT $OUTDIR/XFIRST.${APPL_CASE}.${md1[$i]}

#> input files and directories

 setenv CTM_XFIRST_IN $OUTDIR/XFIRST.${APPL}.${fwd_case}

 setenv CTM_CONC_FWD $OUTDIR/CONC.${APPL}.${fwd_case}  #CONC.${YEAR}${jd1[1]}.${fwd_case}
 setenv CTM_CGRID_FWD $OUTDIR/CGRID.${APPL}.${fwd_case} #.${YEAR}${jd1[1]}.${fwd_case}

 setenv ADJ_CHEM_CHK "$OUTDIR/CHEM_CHK.${APPL}.${fwd_case} -v"
 setenv ADJ_VDIFF_CHK "$OUTDIR/VDIFF_CHK.${APPL}.${fwd_case} -v"
# setenv ADJ_EMIS_CHK "$OUTDIR/EMIS_CHK.${YEAR}${jd1[1]}.${fwd_case} -v"
 setenv ADJ_AERO_CHK "$OUTDIR/AERO_CHK.${APPL}.${fwd_case} -v"
# setenv ADJ_AERO_CHK_1 "$OUTDIR/AERO_CHK.1.${YEAR}${jd1[1]}.${fwd_case} -v"
 setenv ADJ_RHOJ_CHK "$OUTDIR/RHOJ_CHK.${APPL}.${fwd_case} -v"
# setenv ADJ_XADV_CHK "$OUTDIR/XADV_CHK.${YEAR}${jd1[1]}.${fwd_case} -v"
# setenv ADJ_YADV_CHK "$OUTDIR/YADV_CHK.${YEAR}${jd1[1]}.${fwd_case} -v"
# setenv ADJ_ZADV_CHK "$OUTDIR/ZADV_CHK.${YEAR}${jd1[1]}.${fwd_case} -v"
# setenv ADJ_CLD_CHK "$OUTDIR/CLD_CHK.${YEAR}${jd1[1]}.${fwd_case} -v"
# setenv CGRID_CHK "$OUTDIR/CGRID_CHK.${YEAR}${jd1[1]}.${fwd_case} -v"

#set TR_EMpath =
#set TR_EMfile =

@ prev = $i - 1
#> test only
#@ next = $i + 1
@ next = $i
if ($i == 1) then
#   set GC_ICpath = /$M3DATA/cctm/${year}${jd1[1]}/${PBS_JOBID}
#   set GC_ICpath = /data/mturner/data/cctm/2008092/1_day_spinup
#   set GC_ICfile = CONC.fwd_${APPL}.${md1[3]}
   set GC_ICpath = $M3DATA/icon
#   set GC_ICfile = CONC.fwd_yamo_acm2_inline.${md1[3]}
#   set GC_ICfile = ICON_cb05cl_ae5_aq_default_24L_36US
   set GC_ICfile = ICON_2007aq_07c_AERO6_inline_20061222.396_246
   setenv INIT_LGRID_1 "$OUTDIR/LGRID.${APPL_CASE}.${md1[$next]} -v"
#> not yet implemented
#   setenv INIT_EM_1 "$OUTDIR/EM.LGRID.${APPL_CASE}.${md1[$next]} -v"
#   setenv INIT_EM_SF_1 "$OUTDIR/EM_SF.LGRID.${APPL_CASE}.${md1[$next]} -v"
else
   set GC_ICpath = $OUTDIR
   set GC_ICfile = CONC.${APPL}.${fwd_case} #CONC.${fwd_case}.${md1[$prev]}
   setenv INIT_LGRID_1 "$OUTDIR/LGRID.${APPL_CASE}.${md1[$next]} -v"
#   setenv INIT_EM_1 "$OUTDIR/EM.LGRID.${APPL_CASE}.${md1[$next]} -v"
#   setenv INIT_EM_SF_1 "$OUTDIR/EM_SF.LGRID.${APPL_CASE}.${md1[$next]} -v"
endif

 set EMISpath = /nobackup/slcapps/emis
# set EMISpath  = /nobackupp2/mdturne1/cctm/2006356/gen_emis
 set EMISfile  = PT3D.V5g_test.${YEAR}${md1[$i]} 

 set GC_BCpath = $M3DATA/bcon
 set GC_BCfile = BCON_AE6_12US2_${YEAR}${md1[$i]}.ncf

 set METpath   = $M3DATA/met/M_2007
 set extn      = $YER${md1[$i]}.w
 set GC2file = GRIDCRO2D_${extn}
 set GD2file = GRIDDOT2D_${extn}
 set MC2file = METCRO2D_${extn}
 set MD3file = METDOT3D_${extn}
 set MC3file = METCRO3D_${extn}
 set MB3file = METCRO3D.bdy_${extn}

 set TR_DVpath = $METpath
 set TR_DVfile = $MC2file

#> 7-level photolysis data w/ file header
 set JVALpath  = $M3DATA/jproc
# set JVALfile  = JTABLE_${year}${jd1[$i]}
 set JVALfile  = JTABLE_2007152

 set AE_ICpath = $GC_ICpath
 set NR_ICpath = $GC_ICpath
 set TR_ICpath = $GC_ICpath
 set AE_ICfile = $GC_ICfile
 set NR_ICfile = $GC_ICfile
 set TR_ICfile = $GC_ICfile

 set AE_BCpath = $GC_BCpath
 set NR_BCpath = $GC_BCpath
 set TR_BCpath = $GC_BCpath
 set AE_BCfile = $GC_BCfile
 set NR_BCfile = $GC_BCfile
 set TR_BCfile = $GC_BCfile

#> input and output files and directories (boilerplate)
# source $M3HOME/scripts/cctm/in_out.q
 source /home1/slcapps/cmaq_adj/scripts/in_out_adj.q
 if ( $status ) exit 1

#> for the run control ...

 setenv CTM_STDATE      $STDATE
 setenv CTM_STTIME      $STTIME
 setenv CTM_RUNLEN      $NSTEPS
 setenv CTM_TSTEP       $TSTEP
 setenv CTM_PROGNAME    $EXEC

#> look for existing log files
# set test = `ls CTM_LOG_???.${APPL_CASE}`
# if ( "$test" != "" ) then
    if ( $DISP == 'delete' ) then
       echo " ancillary log files being deleted"
#       foreach file ( $test )
#          echo " deleting $file"
#          rm $file
       ls CTM_LOG_???.${APPL_CASE} | xargs rm
#          end
    else if ( $DISP == 'update' ) then
       echo " ancillary log files being deleted"
#       foreach file ( $test )
#          echo " deleting $file"
#          rm $file
       ls CTM_LOG_???.${APPL_CASE} | xargs rm
#       end
    else
       echo "*** Logs exist - run ABORTED ***"
       exit 1
#       endif
    endif

#> - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

 env

 ls -l $EXEC; size $EXEC

 if ( $RM == 'ser' ) then
#> Executable call for single PE
    /usr/bin/time $EXEC
 else
#> Executable call for multiple PE, set location of MPIRUN script
#   set MPIRUN = /opt/mpich/bin/mpirun
#   set TASKMAP = $HOME/loc/machines
#   cat $TASKMAP
#   set MPIRUN = /nasa/intel/impi/4.0.0.028/bin64/mpirun
    set MPIRUN = /nasa/sgi/mpt/2.06rp16/bin/mpiexec
    time $MPIRUN -np $NPROCS $EXEC
 endif

 date
 end

 exit
